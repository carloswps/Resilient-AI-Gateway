#Hugging Face
HF_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_API_BASE_URL=https://router.huggingface.co/v1

# Gateway Security 
GATEWAY_API_KEYS=key-client-a,key-client-b

# MongoDB
MONGO_CONNECTION_STRING=mongodb://mongo:27017
MONGO_DATABASE_NAME=resilient_gateway

# Resilience 
RESILIENCE__GLOBALTTIMEOUTSECONDS=60
RESILIENCE__MAXRETRYATTEMPTS=3
RESILIENCE__BASEDELAYMS=200
RESILIENCE__FALLBACKMODELS=deepseek-ai/DeepSeek-V4-Pro,Qwen/Qwen2.5-7B-Instruct-1M

# ASP.NET Core 
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5243 