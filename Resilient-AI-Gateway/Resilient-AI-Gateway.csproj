<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Resilient_AI_Gateway</RootNamespace>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="DotNetEnv" Version="3.2.0"/>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.3"/>
        <PackageReference Include="MongoDB.Driver" Version="3.8.1"/>
        <PackageReference Include="Polly" Version="8.6.6"/>
        <PackageReference Include="Polly.Core" Version="8.6.6"/>
        <PackageReference Include="Polly.Extensions" Version="8.6.6"/>
        <PackageReference Include="Scalar.AspNetCore" Version="2.14.11"/>
        <PackageReference Include="System.Threading.Tasks" Version="4.3.0"/>
        <PackageReference Include="Asp.Versioning.Http" Version="8.1.0"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\.dockerignore">
            <Link>.dockerignore</Link>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Resilient-AI-Gateway.Shared\Resilient-AI-Gateway.Shared.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <None Update=".env">
            <DependentUpon>.dockerignore</DependentUpon>
        </None>
    </ItemGroup>

</Project>
